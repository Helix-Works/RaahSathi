generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum PreferredLocale {
  EN
  HI
}

enum AuthAttemptStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
  SUPERSEDED
  PROVIDER_FAILED
}

enum SyntheticAuthScenario {
  STANDARD
  PROVIDER_UNAVAILABLE
}

enum ServiceKey {
  LEARNER_LICENCE
  PERMANENT_DRIVING_LICENCE
}

enum ApplicationStatus {
  DRAFT
  IN_PROGRESS
  READY_FOR_IDENTITY
  READY_FOR_PAYMENT
  READY_FOR_APPOINTMENT
  WAITLISTED
  SLOT_OFFERED
  APPOINTMENT_BOOKED
}

enum ApplicationSectionKey {
  PERSONAL_DETAILS
  ADDRESS
  SERVICE_DETAILS
  DECLARATION
}

enum ApplicationEventType {
  APPLICATION_CREATED
  SECTION_SAVED
  SECTION_COMPLETED
  WORKFLOW_ADVANCED
  IDENTITY_STARTED
  IDENTITY_RETRY_STARTED
  IDENTITY_VERIFIED
  PAYMENT_STARTED
  PAYMENT_FAILED
  PAYMENT_SUCCEEDED
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  WAITLIST_JOINED
  WAITLIST_UPDATED
  WAITLIST_LEFT
  SLOT_OFFER_CREATED
  SLOT_OFFER_ACCEPTED
  SLOT_OFFER_DECLINED
  SLOT_OFFER_EXPIRED
}

enum RtoOperationalStatus {
  AVAILABLE
  CENTER_UNAVAILABLE
}

enum BookingServiceStatus {
  AVAILABLE
  BOOKING_SERVICE_UNAVAILABLE
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
}

enum AppointmentRateLimitAction {
  BOOK
  CANCEL
}

enum WaitlistStatus {
  ACTIVE
  OFFERED
  LEFT
  FULFILLED
}

enum WaitlistTimeBucket {
  MORNING
  AFTERNOON
}

enum SlotOfferStatus {
  ACTIVE
  ACCEPTED
  DECLINED
  EXPIRED
}

enum WaitlistRateLimitAction {
  JOIN
  UPDATE
  LEAVE
  ACCEPT_OFFER
  DECLINE_OFFER
}

enum PaymentProviderScenario {
  SUCCESS
  DELAYED_SUCCESS
  DUPLICATE_CALLBACK
  FAILED
  PROVIDER_UNAVAILABLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  PROVIDER_UNAVAILABLE
}

enum PaymentProviderOutcome {
  SUCCESS
  FAILED
}

enum IdentityProviderScenario {
  SUCCESS
  OTP_INVALID
  USER_MISMATCH
  TIMEOUT
  PROVIDER_UNAVAILABLE
  RETRY_REQUIRED
}

enum IdentityOutcome {
  VERIFIED
  OTP_INVALID
  USER_MISMATCH
  TIMEOUT
  PROVIDER_UNAVAILABLE
  RETRY_REQUIRED
}

enum DocumentKind {
  SYNTHETIC_IDENTITY_PROOF
  SYNTHETIC_ADDRESS_PROOF
}

enum LicenceKind {
  LEARNER
}

enum VehicleClass {
  LMV
}

model Applicant {
  id                String                       @id @default(uuid()) @db.Uuid
  mobileLookupHash  String                       @unique
  mobileLast4       String                       @db.Char(4)
  displayName       String
  authScenario      SyntheticAuthScenario        @default(STANDARD)
  preferredLocale   PreferredLocale              @default(EN)
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @db.Timestamptz(3)
  authAttempts      AuthAttempt[]
  sessions          Session[]
  auditEvents       AuditEvent[]                 @relation("AuditActor")
  applications      Application[]
  applicationEvents ApplicationEvent[]           @relation("ApplicationEventActor")
  licences          LicenceRecord[]
  appointments      Appointment[]
  appointmentLimits AppointmentRateLimitBucket[]
  waitlistEntries   WaitlistEntry[]
  waitlistLimits    WaitlistRateLimitBucket[]
}

model AuthAttempt {
  id                String            @id @default(uuid()) @db.Uuid
  applicantId       String?           @db.Uuid
  mobileLookupHash  String
  otpHash           String
  otpSalt           String
  status            AuthAttemptStatus @default(PENDING)
  attemptsRemaining Int
  expiresAt         DateTime          @db.Timestamptz(3)
  resendAvailableAt DateTime          @db.Timestamptz(3)
  consumedAt        DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  applicant         Applicant?        @relation(fields: [applicantId], references: [id], onDelete: SetNull)

  @@index([mobileLookupHash, createdAt])
  @@index([mobileLookupHash, createdAt, status])
  @@index([expiresAt])
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  applicantId       String    @db.Uuid
  tokenHash         String    @unique
  csrfSecretHash    String
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)
  idleExpiresAt     DateTime  @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  applicant         Applicant @relation(fields: [applicantId], references: [id], onDelete: Restrict)

  @@index([applicantId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model AuditEvent {
  id               String     @id @default(uuid()) @db.Uuid
  actorApplicantId String?    @db.Uuid
  eventType        String
  resourceType     String
  resourceId       String?
  metadata         Json?
  correlationId    String
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  actorApplicant   Applicant? @relation("AuditActor", fields: [actorApplicantId], references: [id], onDelete: SetNull)

  @@index([actorApplicantId, createdAt])
  @@index([resourceType, resourceId, createdAt])
}

model Application {
  id               String                   @id @default(uuid()) @db.Uuid
  applicantId      String                   @db.Uuid
  serviceKey       ServiceKey
  status           ApplicationStatus        @default(DRAFT)
  identityScenario IdentityProviderScenario @default(SUCCESS)
  paymentScenario  PaymentProviderScenario  @default(SUCCESS)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3)
  applicant        Applicant                @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  sections         ApplicationSection[]
  events           ApplicationEvent[]
  documents        DocumentRecord[]
  identityAttempts IdentityAttempt[]
  feeSnapshot      FeeSnapshot?
  paymentAttempts  PaymentAttempt[]
  appointment      Appointment?
  waitlistEntries  WaitlistEntry[]

  @@unique([applicantId, serviceKey])
  @@index([applicantId, updatedAt])
}

model FeeSnapshot {
  id                 String           @id @default(uuid()) @db.Uuid
  applicationId      String           @unique @db.Uuid
  baseFeeMinor       Int
  serviceChargeMinor Int
  totalAmountMinor   Int
  currency           String           @db.Char(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  application        Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  paymentAttempts    PaymentAttempt[]

  @@unique([id, applicationId])
}

model PaymentAttempt {
  id                String                 @id @default(uuid()) @db.Uuid
  applicationId     String                 @db.Uuid
  feeSnapshotId     String                 @db.Uuid
  attemptNumber     Int
  idempotencyKey    String                 @unique
  providerReference String                 @unique
  status            PaymentStatus          @default(PENDING)
  amountMinor       Int
  succeededAt       DateTime?               @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)
  application       Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  feeSnapshot       FeeSnapshot             @relation(fields: [feeSnapshotId, applicationId], references: [id, applicationId], onDelete: Restrict)
  providerEvents    PaymentProviderEvent[]

  @@unique([applicationId, attemptNumber])
  @@index([applicationId, createdAt, id])
}

model PaymentProviderEvent {
  id               String                 @id @default(uuid()) @db.Uuid
  paymentAttemptId String                 @db.Uuid
  providerEventId  String                 @unique
  outcome          PaymentProviderOutcome
  amountMinor      Int
  occurredAt       DateTime               @db.Timestamptz(3)
  receivedAt       DateTime               @default(now()) @db.Timestamptz(3)
  paymentAttempt   PaymentAttempt         @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)

  @@index([paymentAttemptId, receivedAt, id])
}

model ApplicationSection {
  id            String                @id @default(uuid()) @db.Uuid
  applicationId String                @db.Uuid
  sectionKey    ApplicationSectionKey
  data          Json
  revision      Int                   @default(1)
  completedAt   DateTime?             @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, sectionKey])
  @@index([applicationId, completedAt])
}

model ApplicationEvent {
  id               String                 @id @default(uuid()) @db.Uuid
  applicationId    String                 @db.Uuid
  actorApplicantId String                 @db.Uuid
  eventType        ApplicationEventType
  sectionKey       ApplicationSectionKey?
  correlationId    String
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  application      Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorApplicant   Applicant              @relation("ApplicationEventActor", fields: [actorApplicantId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt, id])
  @@index([actorApplicantId, createdAt])
}

model DocumentRecord {
  id                 String       @id @default(uuid()) @db.Uuid
  applicationId      String       @db.Uuid
  kind               DocumentKind
  syntheticReference String
  issuedAt           DateTime     @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  application        Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, kind])
  @@index([applicationId, createdAt])
}

model IdentityAttempt {
  id            String           @id @default(uuid()) @db.Uuid
  applicationId String           @db.Uuid
  outcome       IdentityOutcome
  attemptNumber Int
  retryOfId     String?          @unique @db.Uuid
  correlationId String
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  retryOf       IdentityAttempt? @relation("IdentityAttemptRetry", fields: [retryOfId], references: [id], onDelete: Restrict)
  retry         IdentityAttempt? @relation("IdentityAttemptRetry")

  @@unique([applicationId, attemptNumber])
  @@index([applicationId, createdAt, id])
}

model LicenceRecord {
  id                 String       @id @default(uuid()) @db.Uuid
  applicantId        String       @db.Uuid
  kind               LicenceKind
  syntheticReference String       @unique
  vehicleClass       VehicleClass
  issuedAt           DateTime     @db.Timestamptz(3)
  validUntil         DateTime     @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  applicant          Applicant    @relation(fields: [applicantId], references: [id], onDelete: Restrict)

  @@unique([applicantId, kind])
  @@index([applicantId, validUntil])
}

model Rto {
  id                   String               @id @default(uuid()) @db.Uuid
  code                 String               @unique
  nameEn               String
  nameHi               String
  district             String
  operationalStatus    RtoOperationalStatus @default(AVAILABLE)
  bookingServiceStatus BookingServiceStatus @default(AVAILABLE)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  slots                AppointmentSlot[]
  waitlistEntries      WaitlistEntry[]

  @@index([operationalStatus, bookingServiceStatus])
}

model AppointmentSlot {
  id           String        @id @default(uuid()) @db.Uuid
  rtoId        String        @db.Uuid
  serviceKey   ServiceKey
  date         DateTime      @db.Date
  startTime    String        @db.Char(5)
  endTime      String        @db.Char(5)
  capacity     Int
  bookedCount  Int           @default(0)
  heldCount    Int           @default(0)
  vehicleClass VehicleClass  @default(LMV)
  releasedAt   DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  rto          Rto           @relation(fields: [rtoId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  offers       SlotOffer[]

  @@unique([rtoId, serviceKey, date, startTime])
  @@index([rtoId, serviceKey, date, releasedAt])
}

model Appointment {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @unique @db.Uuid
  applicantId   String            @db.Uuid
  slotId        String            @db.Uuid
  status        AppointmentStatus @default(CONFIRMED)
  bookedAt      DateTime          @default(now()) @db.Timestamptz(3)
  cancelledAt   DateTime?         @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  applicant     Applicant         @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  slot          AppointmentSlot   @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@index([applicantId, status, bookedAt])
  @@index([slotId, status])
}

model AppointmentRateLimitBucket {
  id          String                     @id @default(uuid()) @db.Uuid
  applicantId String                     @db.Uuid
  action      AppointmentRateLimitAction
  bucketStart DateTime                   @db.Timestamptz(3)
  count       Int                        @default(1)
  createdAt   DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                   @updatedAt @db.Timestamptz(3)
  applicant   Applicant                  @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([applicantId, action, bucketStart])
  @@index([bucketStart])
}

model WaitlistEntry {
  id                 String               @id @default(uuid()) @db.Uuid
  applicationId      String               @db.Uuid
  applicantId        String               @db.Uuid
  rtoId              String               @db.Uuid
  serviceKey         ServiceKey
  vehicleClass       VehicleClass         @default(LMV)
  acceptableDateFrom DateTime             @db.Date
  acceptableDateTo   DateTime             @db.Date
  timeBuckets        WaitlistTimeBucket[]
  status             WaitlistStatus       @default(ACTIVE)
  joinedAt           DateTime             @default(now()) @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  application        Application          @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  applicant          Applicant            @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  rto                Rto                  @relation(fields: [rtoId], references: [id], onDelete: Restrict)
  offers             SlotOffer[]

  @@index([applicantId, joinedAt, id])
  @@index([rtoId, serviceKey, vehicleClass, status, joinedAt, id])
  @@index([acceptableDateFrom, acceptableDateTo])
}

model SlotOffer {
  id              String          @id @default(uuid()) @db.Uuid
  waitlistEntryId String          @db.Uuid
  slotId          String          @db.Uuid
  status          SlotOfferStatus @default(ACTIVE)
  offeredAt       DateTime        @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime        @db.Timestamptz(3)
  acceptedAt      DateTime?       @db.Timestamptz(3)
  declinedAt      DateTime?       @db.Timestamptz(3)
  expiredAt       DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  waitlistEntry   WaitlistEntry   @relation(fields: [waitlistEntryId], references: [id], onDelete: Restrict)
  slot            AppointmentSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@unique([waitlistEntryId, slotId])
  @@index([slotId, status, expiresAt])
  @@index([waitlistEntryId, status, expiresAt])
}

model WaitlistRateLimitBucket {
  id          String                  @id @default(uuid()) @db.Uuid
  applicantId String                  @db.Uuid
  action      WaitlistRateLimitAction
  bucketStart DateTime                @db.Timestamptz(3)
  count       Int                     @default(1)
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)
  applicant   Applicant               @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([applicantId, action, bucketStart])
  @@index([bucketStart])
}
