generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum PreferredLocale {
  EN
  HI
}

enum AuthAttemptStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
  SUPERSEDED
  PROVIDER_FAILED
}

enum SyntheticAuthScenario {
  STANDARD
  PROVIDER_UNAVAILABLE
}

enum ServiceKey {
  LEARNER_LICENCE
  PERMANENT_DRIVING_LICENCE
}

enum ApplicationStatus {
  DRAFT
  IN_PROGRESS
  READY_FOR_IDENTITY
  READY_FOR_PAYMENT
}

enum ApplicationSectionKey {
  PERSONAL_DETAILS
  ADDRESS
  SERVICE_DETAILS
  DECLARATION
}

enum ApplicationEventType {
  APPLICATION_CREATED
  SECTION_SAVED
  SECTION_COMPLETED
  WORKFLOW_ADVANCED
  IDENTITY_STARTED
  IDENTITY_RETRY_STARTED
  IDENTITY_VERIFIED
}

enum IdentityProviderScenario {
  SUCCESS
  OTP_INVALID
  USER_MISMATCH
  TIMEOUT
  PROVIDER_UNAVAILABLE
  RETRY_REQUIRED
}

enum IdentityOutcome {
  VERIFIED
  OTP_INVALID
  USER_MISMATCH
  TIMEOUT
  PROVIDER_UNAVAILABLE
  RETRY_REQUIRED
}

enum DocumentKind {
  SYNTHETIC_IDENTITY_PROOF
  SYNTHETIC_ADDRESS_PROOF
}

enum LicenceKind {
  LEARNER
}

enum VehicleClass {
  LMV
}

model Applicant {
  id                String                @id @default(uuid()) @db.Uuid
  mobileLookupHash  String                @unique
  mobileLast4       String                @db.Char(4)
  displayName       String
  authScenario      SyntheticAuthScenario @default(STANDARD)
  preferredLocale   PreferredLocale       @default(EN)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  authAttempts      AuthAttempt[]
  sessions          Session[]
  auditEvents       AuditEvent[]          @relation("AuditActor")
  applications      Application[]
  applicationEvents ApplicationEvent[]    @relation("ApplicationEventActor")
  licences          LicenceRecord[]
}

model AuthAttempt {
  id                String            @id @default(uuid()) @db.Uuid
  applicantId       String?           @db.Uuid
  mobileLookupHash  String
  otpHash           String
  otpSalt           String
  status            AuthAttemptStatus @default(PENDING)
  attemptsRemaining Int
  expiresAt         DateTime          @db.Timestamptz(3)
  resendAvailableAt DateTime          @db.Timestamptz(3)
  consumedAt        DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  applicant         Applicant?        @relation(fields: [applicantId], references: [id], onDelete: SetNull)

  @@index([mobileLookupHash, createdAt])
  @@index([mobileLookupHash, createdAt, status])
  @@index([expiresAt])
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  applicantId       String    @db.Uuid
  tokenHash         String    @unique
  csrfSecretHash    String
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)
  idleExpiresAt     DateTime  @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  applicant         Applicant @relation(fields: [applicantId], references: [id], onDelete: Restrict)

  @@index([applicantId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model AuditEvent {
  id               String     @id @default(uuid()) @db.Uuid
  actorApplicantId String?    @db.Uuid
  eventType        String
  resourceType     String
  resourceId       String?
  metadata         Json?
  correlationId    String
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  actorApplicant   Applicant? @relation("AuditActor", fields: [actorApplicantId], references: [id], onDelete: SetNull)

  @@index([actorApplicantId, createdAt])
  @@index([resourceType, resourceId, createdAt])
}

model Application {
  id               String                   @id @default(uuid()) @db.Uuid
  applicantId      String                   @db.Uuid
  serviceKey       ServiceKey
  status           ApplicationStatus        @default(DRAFT)
  identityScenario IdentityProviderScenario @default(SUCCESS)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3)
  applicant        Applicant                @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  sections         ApplicationSection[]
  events           ApplicationEvent[]
  documents        DocumentRecord[]
  identityAttempts IdentityAttempt[]

  @@unique([applicantId, serviceKey])
  @@index([applicantId, updatedAt])
}

model ApplicationSection {
  id            String                @id @default(uuid()) @db.Uuid
  applicationId String                @db.Uuid
  sectionKey    ApplicationSectionKey
  data          Json
  revision      Int                   @default(1)
  completedAt   DateTime?             @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, sectionKey])
  @@index([applicationId, completedAt])
}

model ApplicationEvent {
  id               String                 @id @default(uuid()) @db.Uuid
  applicationId    String                 @db.Uuid
  actorApplicantId String                 @db.Uuid
  eventType        ApplicationEventType
  sectionKey       ApplicationSectionKey?
  correlationId    String
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  application      Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorApplicant   Applicant              @relation("ApplicationEventActor", fields: [actorApplicantId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt, id])
  @@index([actorApplicantId, createdAt])
}

model DocumentRecord {
  id                 String       @id @default(uuid()) @db.Uuid
  applicationId      String       @db.Uuid
  kind               DocumentKind
  syntheticReference String
  issuedAt           DateTime     @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  application        Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, kind])
  @@index([applicationId, createdAt])
}

model IdentityAttempt {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String          @db.Uuid
  outcome       IdentityOutcome
  attemptNumber Int
  retryOfId     String?         @unique @db.Uuid
  correlationId String
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  retryOf       IdentityAttempt? @relation("IdentityAttemptRetry", fields: [retryOfId], references: [id], onDelete: Restrict)
  retry         IdentityAttempt? @relation("IdentityAttemptRetry")

  @@unique([applicationId, attemptNumber])
  @@index([applicationId, createdAt, id])
}

model LicenceRecord {
  id                 String       @id @default(uuid()) @db.Uuid
  applicantId        String       @db.Uuid
  kind               LicenceKind
  syntheticReference String       @unique
  vehicleClass       VehicleClass
  issuedAt           DateTime     @db.Timestamptz(3)
  validUntil         DateTime     @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  applicant          Applicant    @relation(fields: [applicantId], references: [id], onDelete: Restrict)

  @@unique([applicantId, kind])
  @@index([applicantId, validUntil])
}
