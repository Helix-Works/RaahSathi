# Server-only PostgreSQL URLs. Use a pooled runtime host and synthetic development data only.
DATABASE_URL="postgresql://user:password@host-pooler/database?sslmode=require&connect_timeout=15&pool_timeout=15"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"
SHADOW_DATABASE_URL="postgresql://user:password@host/shadow?sslmode=require"

# Server-only synthetic authentication secrets. Replace outside local development.
AUTH_MOBILE_LOOKUP_PEPPER="change-me-development-mobile-pepper-32-chars"
AUTH_OTP_PEPPER="change-me-development-otp-pepper-at-least-32-chars"
AUTH_DEMO_OTP="123456"
# Disabled by default. Enable only on the reviewer deployment to reveal the
# synthetic sign-in values on the login screen.
SHOW_REVIEWER_LOGIN_HINTS="false"

# Server-only secret authenticating synthetic payment-provider callbacks.
PAYMENT_PROVIDER_WEBHOOK_SECRET="change-me-development-payment-webhook-secret-32-chars"

# Optional deterministic clock for synthetic appointment seed dates (Delhi calendar date).
# RAAHSATHI_DEMO_SEED_DATE="2026-08-25"

# Required by every Phase 7 reset/stage/release command. These commands mutate only
# the two enumerated synthetic hero accounts and must never target real citizen data.
RAAHSATHI_DEMO_RESET_CONFIRMATION="RESET_PHASE7_HERO_SYNTHETIC_RECORDS"

# Optional disposable integration database. Never point this at normal development or production data.
TEST_DATABASE_URL="postgresql://user:password@host/raahsathi_test?sslmode=require"
# Set only for a database created to be mutated by integration tests.
TEST_DATABASE_DISPOSABLE_CONFIRMATION="I_UNDERSTAND_THIS_DATABASE_WILL_BE_MUTATED"

# Frontend fixture selection for local development only. Production must use real.
NEXT_PUBLIC_DATA_SOURCE="real"
