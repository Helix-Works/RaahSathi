# Server-only PostgreSQL URLs. Use synthetic development data only.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"
SHADOW_DATABASE_URL="postgresql://user:password@host/shadow?sslmode=require"

# Server-only synthetic authentication secrets. Replace outside local development.
AUTH_MOBILE_LOOKUP_PEPPER="change-me-development-mobile-pepper-32-chars"
AUTH_OTP_PEPPER="change-me-development-otp-pepper-at-least-32-chars"
AUTH_DEMO_OTP="123456"

# Optional disposable integration database. Its database name must include test, ci, or ephemeral.
TEST_DATABASE_URL="postgresql://user:password@host/raahsathi_test?sslmode=require"

# Frontend fixture selection for local development only. Production must use real.
NEXT_PUBLIC_DATA_SOURCE="real"
