{
  "name": "@raahsathi/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.database.config.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:fresh-journey": "node --env-file=.env --import tsx prisma/seed-fresh-journey.ts",
    "openapi:generate": "tsx src/server/openapi/write-openapi.ts",
    "openapi:check": "tsx src/server/openapi/check-openapi.ts"
  },
  "dependencies": {
    "@raahsathi/contracts": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "prisma": "6.19.3"
  }
}
